{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // tooling/** holds the CI/script-only simulators (#2969); the
  // tools/sim and tools/generators scripts drive it. knip resolves those scripts' imports (so tooling
  // files they reach count as used) but does not credit the exports they use,
  // since the scripts sit outside this workspace: the few tooling exports only
  // a script uses carry an `@public` JSDoc tag instead.
  "entry": [
    "scripts/*.mjs",
    "scripts/*.js",
    "App.tsx",
    // Jest test environments: package.json `testEnvironment` and `@jest-environment` docblocks (#3004)
    "jest-env/*.js",
    "../tools/sim/*.ts",
    "../tools/generators/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/*.{js,mjs}",
    "jest-env/*.js",
    "tooling/**/*.ts",
    "../tools/sim/*.ts",
    "../tools/generators/*.ts"
  ],
  "ignore": ["src/screens/__dev__/**", "**/*.web.tsx", "**/*.web.ts"],
  // tsx runs tools/sim and tools/generators (`npx --prefix frontend tsx tools/sim/...`).
  "ignoreDependencies": [
    "tsx",
    // @eslint/js: required by eslint.config.js, installed as an eslint dependency
    "@eslint/js"
  ],
  // Jest resolves `@jest-environment ./jest-env/...` docblocks against <rootDir> (this
  // directory); knip resolves them against the test file. The files are entries above.
  "ignoreUnresolved": ["./jest-env/node.js", "./jest-env/jsdom.js"],
  "ignoreExportsUsedInFile": true
}
