{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // tooling/** holds the CI/script-only simulators (#2969); the
  // tools/sim and tools/generators scripts drive it. knip resolves those scripts' imports (so tooling
  // files they reach count as used) but does not credit the exports they use,
  // since the scripts sit outside this workspace: the few tooling exports only
  // a script uses carry an `@public` JSDoc tag instead.
  "entry": [
    "scripts/*.mjs",
    "scripts/*.js",
    // Production entries (#3126): `knip --production` only follows entries and
    // project globs marked with a trailing `!`.
    "App.tsx!",
    "../tools/sim/*.ts",
    "../tools/generators/*.ts",
    // Metro resolves *.web.ts(x) next to the native file by platform extension
    // (loaded by convention, never imported by name), so they are entries.
    "src/**/*.web.{ts,tsx}!",
    // metro/storeBundle.js resolves hidden premium screens to it in store
    // bundles (#2830); nothing imports it by name.
    "src/screens/StoreBuildExcludedScreen.tsx!"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    // Test-only support code is not production (#3126).
    "!src/test-utils/**!",
    // Test double: releaseBuildConfig.test.ts asserts no production file imports it.
    "!src/purchases/fakeAdapter.ts!",
    // Offline simulation helpers under src/ that only tooling/** and tests
    // import (RNG streams, regret metrics); no production caller by design.
    "!src/game/_shared/simRandom.ts!",
    "!src/game/yacht/oracle/regret.ts!",
    "!src/game/yacht/oracle/regretAggregate.ts!",
    "scripts/*.{js,mjs}",
    "tooling/**/*.ts",
    "../tools/sim/*.ts",
    "../tools/generators/*.ts"
  ],
  "ignore": [
    "src/screens/__dev__/**",
    // Cascade is retired/hidden and kept for the revival epic (#3033). Its
    // files below are only reachable from the cascade screen, which is not an
    // entry, so knip reports them.
    "src/components/cascade/GameCanvas.tsx",
    "src/game/cascade/scoring.ts",
    "src/game/cascade/types.ts",
    // Loaded with a lazy `require("./oracleTable.generated")` in oracle.ts and
    // written by tools/generators/build-yacht-oracle.ts; knip does not follow
    // the lazy require.
    "src/game/yacht/oracle/oracleTable.generated.ts"
  ],
  "ignoreIssues": {
    // Consumed through the `mockScreenDeps()` global (jest.setup.ts does
    // jest.requireActual on this file so jest.mock factories can reach it),
    // never by import, so knip cannot see the uses.
    "src/test-utils/mockScreenDeps.ts": ["exports"],
    // Cascade-only shared types/constants (#3033); only cascade code uses them.
    "src/theme/fruitSets.engine.ts": ["exports", "types"]
  },
  // `python` is the system interpreter for the asset scripts in package.json
  // (process-assets, extract-vertices), not an npm binary.
  "ignoreBinaries": ["python"],
  // tsx runs tools/sim and tools/generators (`npx --prefix frontend tsx tools/sim/...`).
  "ignoreDependencies": [
    "tsx",
    // @eslint/js: required by eslint.config.js, installed as an eslint dependency
    "@eslint/js",
    // poly-decomp: optional runtime peer of matter-js (Cascade physics, #3033);
    // matter-js loads it itself, so the app never imports it.
    "poly-decomp",
    // expo-updates / expo-system-ui: inferred by knip's Expo plugin from
    // app.json (userInterfaceStyle / updates). They are intentionally not
    // installed (native projects are committed), so nothing imports them.
    "expo-updates",
    "expo-system-ui",
    // expo-asset: imported only by the *.web.* files. It ships inside `expo`
    // (already linked natively, see ios/Podfile.lock), so it is not declared:
    // declaring it would count as a native package bump.
    "expo-asset"
  ],
  // Exports that exist only so tests or offline tooling can reach them carry an
  // `@internal` JSDoc tag (#3126); `-internal` excludes them from the report.
  "tags": ["-internal"],
  "ignoreExportsUsedInFile": true
}
