{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/*.mjs", "scripts/*.js", "App.tsx"],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.{js,mjs}"],
  "ignore": [
    "src/screens/__dev__/**",
    "**/*.web.tsx",
    "**/*.web.ts",
    // CI-only simulators; relocated by #2969
    "src/game/*/sim/**",
    "src/game/yacht/oracleBuild/**"
  ],
  "ignoreDependencies": [
    // jsdom: provided by jest-environment-jsdom, selected via @jest-environment docblocks in tests
    "jsdom",
    // @eslint/js: required by eslint.config.js, installed as an eslint dependency
    "@eslint/js"
  ],
  "ignoreExportsUsedInFile": true
}
