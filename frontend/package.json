{
  "name": "frontend",
  "version": "1.0.8",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "translate": "node scripts/translate.js",
    "check-i18n": "node scripts/check-i18n-strings.js",
    "process-assets": "python scripts/remove_backgrounds.py",
    "extract-vertices": "python scripts/extract_vertices.py",
    "bundlesize": "bundlesize",
    "check-build-env": "node scripts/check-build-env.js",
    "prebuild": "node scripts/optimize-assets.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "setupFilesAfterEnv": [
      "./jest.setup-after-env.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.worktrees/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|i18next|react-i18next|i18next-resources-to-backend)"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80
      },
      "./src/game/solitaire/engine.ts": {
        "lines": 80
      },
      "./src/game/freecell/engine.ts": {
        "lines": 80
      },
      "./src/game/hearts/engine.ts": {
        "lines": 80
      }
    },
    "moduleNameMapper": {
      "\\.(mp3|ogg)$": "<rootDir>/src/__mocks__/fileMock.js"
    }
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@sentry/react-native": "~8.20.0",
    "@shopify/react-native-skia": "2.11.0",
    "expo": "^57.0.12",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-dev-client": "~57.0.11",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-modules-core": "^57.0.10",
    "expo-screen-orientation": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "i18next-resources-to-backend": "^1.2.3",
    "matter-js": "^0.20.0",
    "poly-decomp": "^0.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-audio-api": "0.13.2",
    "react-native-gesture-handler": "3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.11.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@expo/config-plugins": "~57.0.8",
    "@react-native/jest-preset": "~0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/matter-js": "^0.20.2",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.67.0",
    "bundlesize2": "^0.0.35",
    "eslint": "^9.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^17.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.8",
    "sharp": "^0.35.3",
    "source-map-explorer": "^2.5.3",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "bundlesize": [
    {
      "path": "./dist/index.android.bundle",
      "maxSize": "8 mB",
      "compression": "none"
    }
  ],
  "private": true,
  "overrides": {
    "picomatch": ">=2.3.2 <4 || >=4.0.4",
    "node-forge": ">=1.3.4",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1",
    "react-dom": "$react",
    "react-test-renderer": "$react"
  }
}
