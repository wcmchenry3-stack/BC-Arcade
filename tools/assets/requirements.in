# Human-edited input for the asset tools' lock (#4001). Do not install from this file: install
# requirements.txt, which is generated from it with hashes. Procedure: docs/ASSETS.md ("Pinned generator libraries").
#
# Generator libraries are pinned exactly (#3672, #3816): the shipped sprites and sounds are their
# output, and a release of any of them can move it (#3594: Pillow 12.x LANCZOS downscale differs from 13).
# Upgrading one means regenerating every generated asset and reviewing the diff: docs/ASSETS.md.
numpy==2.4.6
scipy==1.17.1
Pillow==13.0.0
colour-science==0.4.7
fonttools==4.68.0
pytest==9.2.0
pyyaml==6.0.3
# The Star Swarm music recipe writes its bed as a 16-bit WAV with libsndfile, as Round 44 did.
soundfile==0.14.0
# Windows-only dependency of pytest. pip-compile resolves for the platform it runs on and evaluates
# environment markers there, so a `; sys_platform == "win32"` line is dropped on Linux and the lock would
# lack colorama. Listed without a marker it is pinned and hashed (and installed, harmlessly, on Linux/macOS)
# so a --require-hashes install on Windows works (#4001).
colorama==0.4.6
